[Unit]
Description=Evasion ERP WebSocket Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/evasion
ExecStart=/usr/bin/php /var/www/evasion/bin/websocket-server.php
Restart=always
RestartSec=3
User=www-data
Group=www-data
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
